{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "printWidth": 100,
  "endOfLine": "lf",
  "sortPackageJson": true,
  "sortTailwindcss": true,
  "ignorePatterns": ["dist/**", "node_modules/**", "*.lock", "package-lock.json", ".git/**"]
}
